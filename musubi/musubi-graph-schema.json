{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Musubi Graph Schema (結び正規形)",
  "description": "JSON Schema for musubi-model where ties (結び) are primary and nodes are derived as equivalence classes",
  "type": "object",
  "properties": {
    "F": {
      "type": "integer",
      "description": "Number of flags (半辺集合の要素数)",
      "minimum": 0
    },
    "E": {
      "type": "integer",
      "description": "Number of edges (エッジ識別集合の要素数)",
      "minimum": 0
    },
    "eps": {
      "type": "array",
      "description": "Incidence function ε: F→E (どのフラグがどのエッジに属すか)",
      "items": {
        "type": "integer",
        "minimum": 0
      },
      "minItems": 0
    },
    "ties": {
      "type": "array",
      "description": "Equivalence relation generators (同値関係の生成元: 同じ場で結ばれるフラグ群)",
      "items": {
        "type": "array",
        "description": "Pair of flag indices [f1, f2] where f1 < f2 (昇順ペア)",
        "items": {
          "type": "integer",
          "minimum": 0
        },
        "minItems": 2,
        "maxItems": 2,
        "uniqueItems": true
      }
    },
    "w": {
      "type": "array",
      "description": "Edge weights (重み: 任意の構造)",
      "items": {
        "type": "object",
        "properties": {
          "e": {
            "type": "integer",
            "description": "Edge index",
            "minimum": 0
          },
          "val": {
            "description": "Weight value (任意の型)"
          }
        },
        "required": ["e"],
        "additionalProperties": true
      }
    },
    "meta": {
      "type": "object",
      "description": "Metadata for graph configuration",
      "properties": {
        "schema": {
          "type": "integer",
          "description": "Schema version"
        },
        "oriented": {
          "type": "boolean",
          "description": "Whether edges are oriented/directed"
        },
        "name": {
          "type": "string",
          "description": "Graph name/identifier"
        },
        "semiring": {
          "type": "string",
          "description": "Weight semiring type",
          "enum": ["R", "Q", "Fp", "Bool", "Tropical"]
        },
        "local_rules": {
          "type": "array",
          "description": "Local rewrite rules for tie generation",
          "items": {
            "type": "object",
            "properties": {
              "pattern": {
                "type": "array",
                "description": "Pattern to match"
              },
              "replacement": {
                "type": "array",
                "description": "Replacement rule"
              }
            }
          }
        }
      },
      "additionalProperties": true
    }
  },
  "required": ["F", "E", "eps"],
  "additionalProperties": false
}
